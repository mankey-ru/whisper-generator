# Reference: ~/.claude/.editorconfig (my-global-agent-rules).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
quote_type = single
curly_bracket_next_line = false
# Prettier takes printWidth from here; keeps long inline arrow functions on one line
max_line_length = 120

[{*.json,*.yml,*.yaml,.prettierrc}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space

[*.svg]
insert_final_newline = false

# ---- Project additions below; keep everything above verbatim ----
