{
  "name": "whisper-generator",
  "version": "1.0.0",
  "description": "Using whisper.cpp and ffmpeg to generate transcriptions of audio files and html with clickable timecodes",
  "type": "module",
  "main": "start.js",
  "bin": {
    "whisper-html": "./start.js"
  },
  "scripts": {
    "start": "node .",
    "start-debug": "npm start -- --debug",
    "start-tmp": "npm start -- --debug --input ./tmp",
    "get": "node ./lib/get-models.js"
  },
  "author": "mankey-ru",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0"
  }
}
